{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub inheritance profile",
  "description": "Canonical profile shape under ADR-024 I-2 and I-6.",
  "type": "object",
  "required": ["archetype"],
  "properties": {
    "archetype": { "enum": ["A", "B", "C", "D"] },
    "environment": { "$ref": "#/$defs/environment", "default": "local" },
    "secondary_environments": {
      "type": "array",
      "items": { "$ref": "#/$defs/environment" },
      "default": []
    },
    "project_specific_directories": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectDirectory" },
      "default": []
    },
    "last_sync": { "$ref": "#/$defs/pin" },
    "deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" },
      "default": []
    }
  },
  "additionalProperties": true,
  "$defs": {
    "environment": { "enum": ["local", "gigacode", "serverless"] },
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "projectDirectory": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonBlank",
          "not": { "pattern": "^/|(^|/)\\.\\.(/|$)" }
        },
        "reason": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "pin": {
      "type": "object",
      "required": ["hub_sha", "date", "scope", "tool"],
      "properties": {
        "hub_sha": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "date": {
          "description": "UTC calendar date of the successful write.",
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "scope": { "$ref": "#/$defs/nonBlank" },
        "tool": {
          "description": "Tool name or path followed by @ and an exact release or commit ID.",
          "type": "string",
          "pattern": "^[^\\s@]+@(?:v?[0-9]+(?:\\.[0-9]+)+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?|[0-9a-fA-F]{12,40})(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "deviation": {
      "type": "object",
      "required": ["reason", "declared_by", "issue"],
      "oneOf": [
        { "required": ["path"] },
        { "required": ["section"] }
      ],
      "properties": {
        "path": {
          "description": "Literal repository-relative path with optional trailing slash.",
          "type": "string",
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?(?![\\s\\S])",
          "not": { "pattern": "^/|^[A-Za-z]:|//|(^|/)\\.{1,2}(/|$)|[\\u0000-\\u001f\\u007f\\\\*?\\[\\]]" }
        },
        "section": {
          "description": "Exact section identifier or heading, compared literally.",
          "type": "string",
          "pattern": "^\\S(?:[^\\r\\n]*\\S)?(?![\\s\\S])",
          "not": { "pattern": "[\\u0000-\\u001f\\u007f]" }
        },
        "reason": { "$ref": "#/$defs/nonBlank" },
        "declared_by": { "enum": ["owner", "project"] },
        "issue": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/(?!(?:\\.{1,2})/)[A-Za-z0-9_.-]+/issues/[1-9][0-9]*(?:#issuecomment-[1-9][0-9]*)?(?![\\s\\S])"
        }
      }
    }
  }
}
