{
  "genome_version": "1.1",
  "description": "Declarative genome of Hub spokes, read from the pinned Hub commit (ADR-024, B-239, B-240). Each archetype declares its base genome and optional practices. Starter files become project-owned when customized.",
  "placeholders": ["date", "hub_sha", "hub_url", "project_name"],
  "archetypes": {
    "B": {
      "profile_template": "templates/spoke/.hub-profile.json",
      "units": {
        "genome": {
          "description": "Production spoke: bootstrap, agent contracts, governance and operations, plus common issue templates, handover and the bootstrap validator.",
          "map": [
            "templates/spoke/=",
            "templates/htom/.github/ISSUE_TEMPLATE/=.github/ISSUE_TEMPLATE/",
            "templates/htom/ai-rules/AI_SESSION_HANDOVER_PROMPT.md=ai-rules/AI_SESSION_HANDOVER_PROMPT.md",
            "templates/htom/ops/=ops/",
            "templates/htom/tools/validate-agents-bootstrap.sh=tools/validate-agents-bootstrap.sh"
          ],
          "exclude": [
            "templates/spoke/.hub-profile.json"
          ],
          "starter": [".github/workflows/ci.yml", "README.md"],
          "delegated": []
        }
      }
    },
    "D": {
      "profile_template": "templates/htom/.hub-profile.json",
      "units": {
        "genome": {
          "description": "HTOM genome: templates/htom without the one-shot init.sh, with canonical contracts and generated redirects for their old root paths.",
          "map": [
            "templates/htom/="
          ],
          "exclude": [
            "templates/htom/.hub-profile.json",
            "templates/htom/init.sh"
          ],
          "starter": ["README.md"],
          "delegated": []
        }
      }
    }
  }
}
