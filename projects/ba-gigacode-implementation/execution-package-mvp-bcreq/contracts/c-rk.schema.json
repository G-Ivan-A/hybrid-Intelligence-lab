{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/c-rk.schema.json",
  "title": "C-RK — контракт маршрута и его прослеживаемости",
  "description": "Схема листа прогона (run sheet): проекции графа маршрута на конкретное исполнение. Журнал событий append-only: запись о пройденном узле не редактируется, исправление добавляется новой записью. Лист прогона заменяет свободный файл памяти проекта — состояние прогона обязано быть машиночитаемым.",
  "type": "object",
  "required": ["run_id", "route_id", "task_id", "started_at", "events"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{4}$"},
    "route_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string"},
    "outcome": {"enum": ["completed", "refused", "escalated", "in-progress"]},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "node", "skill", "actor", "verdict", "at"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "node": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "minLength": 1},
          "actor": {"enum": ["agent", "human"]},
          "verdict": {"enum": ["pass", "reject", "refused", "skipped"]},
          "gate": {"enum": ["G-self", "G-mach", "G-human"]},
          "attempt": {"type": "integer", "minimum": 1, "maximum": 2, "description": "после отказа G-mach допустима ровно одна корректирующая попытка; вторая эскалирует на G-human"},
          "decision": {"type": "string", "description": "выбранное ребро и предикат, по которому оно выбрано"},
          "rationale": {"type": "string"},
          "artifact_ref": {"type": "string"},
          "at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
