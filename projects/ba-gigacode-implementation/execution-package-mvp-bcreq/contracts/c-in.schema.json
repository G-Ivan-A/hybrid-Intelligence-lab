{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/c-in.schema.json",
  "title": "C-IN — контракт входа маршрута",
  "description": "Вход маршрута считается принятым, только если объявлены продукт, задача и источник. Правило PT-1: продуктовый класс объявляется до начала шага и не выводится из текста. Правило MM-1: артефакт без класса не существует. Непринятый вход останавливает маршрут (GT-2, fail-closed), а не помечается предупреждением.",
  "type": "object",
  "required": ["artifact_class", "state", "task", "products", "sources", "language"],
  "additionalProperties": false,
  "properties": {
    "artifact_class": {"const": "A-IN"},
    "state": {"const": "raw"},
    "task": {
      "type": "object",
      "required": ["id", "title", "requested_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "requested_by": {"type": "string", "minLength": 1}
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "description": "Реестр продуктов задачи по правилу MP-2, объявляется до генерации.",
      "items": {
        "type": "object",
        "required": ["marker", "product_class", "atomic_function", "profile", "owner"],
        "additionalProperties": false,
        "properties": {
          "marker": {"type": "string", "pattern": "^[A-ZА-Я]$"},
          "product_class": {"enum": ["contact-center", "voice-ucaas", "analytics-reporting"]},
          "atomic_function": {"type": "string", "minLength": 1},
          "profile": {"enum": ["P-SETTINGS", "P-NO-SETTINGS", "P-DEVICE", "P-API"]},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Каждый источник разрешим: по нему проверяется существование цитаты операцией check-source-evidence.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "locator", "content"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[0-9]{2}$"},
          "kind": {"enum": ["transcript", "document", "email", "ticket", "system-export"]},
          "locator": {"type": "string", "minLength": 1, "description": "документ, раздел, страница или таймкод"},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "language": {"const": "ru"}
  }
}
