{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "formatter": false,
  "lsp": false,
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "edit": {
      "*": "deny",
      "submissions/TASK-*.json": "ask",
      "*/submissions/TASK-*.json": "ask"
    },
    "kb-readonly_*": "ask",
    "bash": "deny",
    "task": "deny",
    "skill": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
