{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/G-Ivan-A/hybrid-Intelligence-lab/blob/main/projects/ba-ai-process/build/common/contracts/c-release-manifest.schema.json",
  "title": "BCREQ Release compilation manifest and reverse trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "working_baseline_id",
    "working_digest",
    "release_profile",
    "release_profile_version",
    "audience",
    "included_ids",
    "excluded",
    "fragments",
    "release_digest"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^REL-[0-9]{3}$"
    },
    "working_baseline_id": {
      "type": "string",
      "pattern": "^WB-[0-9]{3}$"
    },
    "working_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release_profile": {
      "const": "BCREQ-client-v1"
    },
    "release_profile_version": {
      "const": 1
    },
    "audience": {
      "const": "customer"
    },
    "included_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policy",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "enum": [
              "internal_only",
              "conditional"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release_fragment",
          "working_ids"
        ],
        "properties": {
          "release_fragment": {
            "type": "string",
            "pattern": "^RF-[0-9]{3}$"
          },
          "working_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "release_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
