{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/c-quest.schema.json",
  "title": "C-QUEST — контракт перечня вопросов Заказчику",
  "description": "Выход P-02. Вопрос отвечается одним фактом и адресован конкретной неразрешённой неоднозначности A-CORE: вопрос без ссылки на неоднозначность неотличим от любопытства и не имеет критерия закрытия.",
  "type": "object",
  "required": ["artifact_class", "state", "task_id", "products", "product_attribution", "questions"],
  "additionalProperties": false,
  "definitions": {
    "product": {
      "type": "object",
      "required": ["marker", "domain", "capability", "feature", "atomic_function", "profile", "owner"],
      "additionalProperties": false,
      "properties": {
        "marker": {"type": "string", "pattern": "^[A-ZА-Я]$"},
        "domain": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "feature": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "atomic_function": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "profile": {"enum": ["P-SETTINGS", "P-NO-SETTINGS", "P-DEVICE", "P-API"]},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "product_attribution": {
      "type": "object",
      "required": ["status", "confirmed_by", "confirmed_at", "decision_ref", "binding_digest"],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "confirmed"},
        "proposed_by": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "decision_ref": {"type": "string", "minLength": 1},
        "binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "artifact_class": {"const": "A-QUEST"},
    "state": {"enum": ["draft", "in-review", "validated", "approved"]},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "products": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/product"}},
    "product_attribution": {"$ref": "#/definitions/product_attribution"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ambiguity_id", "text", "addressee", "rank", "rank_rationale"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^Q-[0-9]{2}$"},
          "ambiguity_id": {"type": "string", "pattern": "^AMB-[0-9]{2}$"},
          "text": {"type": "string", "minLength": 1},
          "addressee": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1},
          "rank_rationale": {"type": "string", "minLength": 1},
          "answer": {"type": "string"}
        }
      }
    }
  }
}
