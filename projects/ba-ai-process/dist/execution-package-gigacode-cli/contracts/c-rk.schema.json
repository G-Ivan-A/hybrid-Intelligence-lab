{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/c-rk.schema.json",
  "title": "C-RK — контракт маршрута и его прослеживаемости",
  "description": "Схема листа прогона (run sheet): проекции графа маршрута на конкретное исполнение. Журнал событий append-only: запись о пройденном узле не редактируется, исправление добавляется новой записью. Лист прогона заменяет свободный файл памяти проекта — состояние прогона обязано быть машиночитаемым.",
  "type": "object",
  "required": ["run_id", "route_id", "task_id", "started_at", "products", "product_attribution", "events", "handover"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{4}$"},
    "route_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "started_at": {"type": "string", "minLength": 1},
    "products": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["marker", "domain", "capability", "feature", "atomic_function", "profile", "owner"],
        "additionalProperties": false,
        "properties": {
          "marker": {"type": "string", "pattern": "^[A-ZА-Я]$"},
          "domain": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "feature": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "atomic_function": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "profile": {"enum": ["P-SETTINGS", "P-NO-SETTINGS", "P-DEVICE", "P-API"]},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "product_attribution": {
      "type": "object",
      "required": ["status", "confirmed_by", "confirmed_at", "decision_ref", "binding_digest"],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "confirmed"},
        "proposed_by": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "decision_ref": {"type": "string", "minLength": 1},
        "binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "finished_at": {"type": "string"},
    "outcome": {"enum": ["completed", "refused", "escalated", "awaiting-human", "in-progress"]},
    "handover": {
      "type": "object",
      "required": ["objective", "ssot_refs", "process_version", "current_node", "path", "decisions", "gate_results", "open_items", "artifact_refs"],
      "additionalProperties": false,
      "properties": {
        "objective": {"type": "string"},
        "ssot_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "process_version": {"type": "string", "minLength": 1},
        "current_node": {"type": "string"},
        "path": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "gate_results": {"type": "array", "items": {"type": "string"}},
        "open_items": {"type": "array", "items": {"type": "string"}},
        "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "event_type", "actor", "input_ref", "output_ref", "at"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "event_type": {"enum": ["skill-invocation", "knowledge-query", "validation", "gate", "transition", "artifact-write"]},
          "node": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "minLength": 1},
          "actor": {"enum": ["agent", "human"]},
          "verdict": {"enum": ["pass", "reject", "refused", "skipped"]},
          "gate": {"enum": ["G-self", "G-mach", "G-human"]},
          "attempt": {"type": "integer", "minimum": 1, "maximum": 1, "description": "reject останавливает автоматическое исполнение; повтор возможен только по новому решению человека"},
          "input_ref": {"type": "string"},
          "output_ref": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "tool": {"type": "string"},
          "decision": {"type": "string", "description": "выбранное ребро и предикат, по которому оно выбрано"},
          "rationale": {"type": "string"},
          "at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
