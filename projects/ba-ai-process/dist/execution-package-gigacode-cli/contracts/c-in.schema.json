{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/c-in.schema.json",
  "title": "C-IN — контракт входа маршрута",
  "description": "A-IN может войти в product routing preflight со статусом pending. К основным узлам маршрут допускает вход только после явного подтверждения бизнес-аналитиком полной цепочки MANGO Domain → Capability → Feature → Atomic Function. Неподтверждённая или неразрешимая привязка останавливает маршрут fail-closed.",
  "type": "object",
  "required": [
    "artifact_class",
    "state",
    "task",
    "work_type",
    "routing",
    "products",
    "product_attribution",
    "sources",
    "language"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "product_attribution": {
            "properties": {"status": {"const": "confirmed"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "products": {"minItems": 1},
          "product_attribution": {
            "required": ["status", "confirmed_by", "confirmed_at", "decision_ref", "binding_digest"]
          }
        }
      }
    }
  ],
  "properties": {
    "work_type": {
      "enum": ["mango-change", "mango-kb", "industry-practice", "external-spec"]
    },
    "routing": {
      "type": "object",
      "required": ["primary_axis", "rule", "decision", "decision_ref"],
      "additionalProperties": false,
      "properties": {
        "primary_axis": {"enum": ["mango", "industry"]},
        "rule": {"enum": ["mango-change", "mango-kb", "industry-practice", "external-spec"]},
        "decision": {"enum": ["pending", "confirmed", "rejected"]},
        "decision_ref": {"type": "string", "minLength": 1}
      }
    },
    "artifact_class": {
      "const": "A-IN"
    },
    "state": {
      "const": "raw"
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "requested_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requested_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "products": {
      "type": "array",
      "description": "Кандидатный либо подтверждённый реестр цепочек из taxonomy/mango-products.yaml. Пустой массив допустим только до product routing preflight.",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "marker",
          "domain",
          "capability",
          "feature",
          "atomic_function",
          "profile",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "marker": {
            "type": "string",
            "pattern": "^[A-ZА-Я]$"
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "feature": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "atomic_function": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "profile": {
            "enum": [
              "P-SETTINGS",
              "P-NO-SETTINGS",
              "P-DEVICE",
              "P-API"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "product_attribution": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "confirmed", "rejected"]
        },
        "proposed_by": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_by": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 канонического JSON массива products; downstream-артефакты обязаны переносить значение без изменения."
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Каждый источник разрешим: по нему проверяется существование цитаты операцией check-source-evidence. Уровень источника объявляется до прогона словарём taxonomy/source-tiers.yaml и задаёт обязательную форму доказательства: вклеенный текст (EF-INLINE) или извлечённая цитата с отметкой времени (EF-QUOTE). Источник без уровня — необъявленная ветка маршрутизации, вход отвергается.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "tier",
          "locator"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "transcript",
              "document",
              "email",
              "ticket",
              "system-export"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "description": "документ, раздел, страница или таймкод"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "дословный текст источника; обязателен для формы EF-INLINE"
          },
          "tier": {
            "enum": [
              "ST-1-ATTACHED",
              "ST-2-CORPUS",
              "ST-3-PRODUCT-DOC",
              "ST-4-HUMAN"
            ],
            "description": "уровень источника из закрытого словаря source-tiers; порядок применения ST-1 → ST-2 → ST-3 → ST-4"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "дословная цитата извлечённого фрагмента; обязательна для формы EF-QUOTE"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "description": "момент извлечения; без него цитата невоспроизводима"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "tier": {
                  "enum": [
                    "ST-1-ATTACHED",
                    "ST-4-HUMAN"
                  ]
                }
              },
              "required": [
                "tier"
              ]
            },
            "then": {
              "required": [
                "content"
              ],
              "description": "EF-INLINE: материал задачи и ответ человека существуют только вклеенными"
            }
          },
          {
            "if": {
              "properties": {
                "tier": {
                  "enum": [
                    "ST-2-CORPUS",
                    "ST-3-PRODUCT-DOC"
                  ]
                }
              },
              "required": [
                "tier"
              ]
            },
            "then": {
              "required": [
                "quote",
                "retrieved_at"
              ],
              "description": "EF-QUOTE: извлечение допустимо, но доказательством является цитата с отметкой времени, а не факт обращения"
            }
          }
        ]
      }
    },
    "language": {
      "const": "ru"
    }
  }
}
